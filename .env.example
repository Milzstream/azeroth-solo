# Copy to .env. .env is gitignored. Change the database password before the first start.
# If this variable is left empty, the pinned docker-compose.yml uses "password".

DOCKER_DB_ROOT_PASSWORD=change-me

# Host uid/gid for files the containers create. Match your user (`id -u` / `id -g`).
DOCKER_USER_ID=1000
DOCKER_GROUP_ID=1000

# Host path of extracted client data, relative to this repo
# (the compose project directory). Not the core data/ SQL tree.
# Put dbc, maps, vmaps, mmaps, and Cameras in client-data/. Do not commit them.
DOCKER_VOL_DATA=./client-data

# Absolute path to your own 3.3.5a client's Data directory (the folder of MPQs).
# Used only by the optional ac-tools service. Not a download.
DOCKER_AC_CLIENT_FOLDER=

DOCKER_AUTH_EXTERNAL_PORT=3724
DOCKER_WORLD_EXTERNAL_PORT=8085
DOCKER_DB_EXTERNAL_PORT=3306
