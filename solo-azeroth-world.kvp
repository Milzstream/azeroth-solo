Meta.DisplayName=Solo Azeroth World
Meta.Description=AzerothCore 3.3.5a worldserver with mod-playerbots, per-character individual progression starting at Classic, and mod-ollama-chat (needs an Ollama URL). Wrath client, not Classic or Retail. Native process, not a container.
Meta.OS=Windows, Linux
Meta.AarchSupport=Unknown
Meta.Arch=x86_64
Meta.Author=Milz
Meta.URL=https://github.com/Milzstream/azeroth-solo
Meta.DisplayImageSource=
Meta.EndpointURIFormat=
Meta.ConfigManifest=solo-azeroth-worldconfig.json
Meta.MetaConfigManifest=solo-azeroth-worldmetaconfig.json
Meta.ConfigRoot=solo-azeroth-world.kvp
Meta.MinAMPVersion=2.4.6.4
Meta.DockerRequired=False
Meta.Prerequisites=[]
Meta.ExtraSetupStepsURI=
Meta.ConfigReleaseState=NotSpecified
Meta.NoCommercialUsage=False
Meta.ConfigVersion=1
Meta.ReleaseNotes=
Meta.BreakingReleaseNotes=
Meta.AppConfigId=bd98e73a-561e-40c9-b55c-1a625ce81457
Meta.AppIsMultiIPAware=False
App.DisplayName=Solo Azeroth World
App.RootDir=./solo-azeroth/
App.BaseDirectory=./solo-azeroth/serverfiles/
App.SteamWorkshopDownloadLocation=
App.ExecutableWin=serverfiles\bin\worldserver.exe
App.ExecutableLinux=serverfiles/bin/worldserver
App.WorkingDir=serverfiles
App.LinuxCommandLineArgs=-c etc/worldserver.conf
App.WindowsCommandLineArgs=-c configs/worldserver.conf
App.CommandLineArgs={{$PlatformArgs}} {{$FormattedArgs}}
App.UseLinuxIOREDIR=False
App.AppSettings={}
App.EnvironmentVariables={}
App.CommandLineParameterFormat=-{0} "{1}"
App.CommandLineParameterDelimiter= 
App.ExitMethod=String
App.ExitTimeout=60
App.ExitString=server exit
App.ExitFile=app_exit.lck
App.HasWriteableConsole=True
App.HasReadableConsole=True
App.SupportsLiveSettingsChanges=False
App.LiveSettingChangeCommandFormat=
App.ApplicationIPBinding=0.0.0.0
App.Ports=@IncludeJson[solo-azeroth-worldports.json]
App.AdminPortRef=0
App.PrimaryApplicationPortRef=MainGamePort
App.UniversalSleepApplicationUDPPortRef=0
App.UniversalSleepSteamQueryPortRef=0
App.MaxUsers=1000
App.UseRandomAdminPassword=False
App.PersistRandomPassword=False
App.RemoteAdminPassword=
App.AdminMethod=STDIO
App.AdminLoginTransform=None
App.LoginTransformPrefix=
App.RCONConnectDelaySeconds=5
App.RCONConnectRetrySeconds=5
App.RCONHeartbeatMinutes=0
App.RCONHeartbeatCommand=
App.TelnetLoginFormat={0}
App.UpdateSources=@IncludeJson[solo-azerothupdates.json]
App.PreStartStages=[]
App.ForceUpdate=False
App.ForceUpdateReason=
App.Compatibility=LinuxBufferedConsole
App.SteamUpdateAnonymousLogin=True
App.SteamForceLoginPrompt=False
App.RapidStartup=False
App.MonitorChildProcess=False
App.DumpFullChildProcessTree=False
App.MonitorChildProcessWaitMs=1000
App.MonitorChildProcessName=
App.SupportsUniversalSleep=False
App.WakeupMode=Any
App.ApplicationReadyMode=RegexMatch
Console.FilterMatchRegex=
Console.FilterMatchReplacement=
Console.ThrowawayMessageRegex=
Console.AppReadyRegex=\(worldserver-daemon\) ready\.\.\.
Console.UserJoinRegex=^$
Console.UserLeaveRegex=^$
Console.UserChatRegex=^$
Console.UpdateAvailableRegex=^$
Console.MetricsRegex=
Console.SuppressLogAtStart=False
Console.ActivateLogRegex=
Console.UserActions={}
Limits.SleepMode=False
